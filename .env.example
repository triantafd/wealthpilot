# Copy to .env and fill in. .env is gitignored — never commit it.
#
#   cp .env.example .env
#
# One file at the repo root serves both sides: docker-compose.yml reads the
# POSTGRES_* values, and the backend reads all of them through app/config.py,
# which resolves this path from its own location rather than the working
# directory (backend commands run from backend/, eval commands from the root).

# --- Application ------------------------------------------------------------
APP_ENV=local                      # local | ci | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Models -----------------------------------------------------------------
# "provider:model", consumed by LangChain's init_chat_model() so the provider
# can be switched without touching code.
LLM_MODEL=openai:gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Must equal the VECTOR(n) width of chunks.embedding. Changing it requires a
# migration and a full re-embed, so it is not a runtime switch.
EMBEDDING_DIMENSIONS=1536

OPENAI_API_KEY=
# Only needed if LLM_MODEL points at anthropic:*
ANTHROPIC_API_KEY=

# --- Postgres ---------------------------------------------------------------
# Shared with docker-compose.yml. The backend composes its DSN from these
# parts, so the port lives in exactly one place.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wealthpilot
POSTGRES_PASSWORD=wealthpilot
POSTGRES_DB=wealthpilot

# Read-only role that executes model-generated SQL (ARCHITECTURE section 5).
# Created by an Alembic migration. Leave blank until then: there is no fallback
# to the owner role, by design.
POSTGRES_RO_USER=
POSTGRES_RO_PASSWORD=

# --- Observability ----------------------------------------------------------
# Langfuse Cloud. Tracing is optional: leave these blank and the app runs with
# tracing disabled, so the test suite and CI need no account.
#
# The host must match the region that issued the keys — keys from the EU
# project are rejected by the US endpoint and vice versa.
#   EU: https://cloud.langfuse.com      US: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Retrieval variants -----------------------------------------------------
# Defaults are what the committed baseline measures. Phase 3 compared the
# alternatives and recorded every one in docs/EXPERIMENTS.md; these exist so a
# finding can be re-checked, not because they are recommended.
#
# vector (default) | text | hybrid
RETRIEVAL_MODE=vector
# Cross-encoder reranking. Needs the optional dependency group:
# `uv sync --group rerank`. Measured as better on MRR and worse on hit@1.
RETRIEVAL_RERANK=false
# Exclude the repeated title and disclaimer from what gets embedded. On by
# default. Changing it requires a re-ingest with --force.
EMBED_STRIP_BOILERPLATE=true
