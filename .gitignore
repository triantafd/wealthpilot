# Secrets — see app/config.py; .env.example is the committed template
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node
node_modules/
dist/
*.tsbuildinfo
.vite/
playwright-report/
test-results/

# Eval reports: baseline.json is committed on purpose, timestamped runs are not
evals/reports/*.json
!evals/reports/baseline.json

# Local model caches (sentence-transformers reranker).
# Anchored to the repo root: an unanchored "models/" also matches source
# directories such as backend/app/db/models/.
/.cache/
/models/

# OS / editor
.DS_Store
*.swp
.idea/
