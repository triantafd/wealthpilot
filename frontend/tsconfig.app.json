{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strict mode is a project rule, and the Vite template does not enable it. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* shadcn/ui generates "@/..." imports; this must stay in step with the
       alias in vite.config.ts. */
    "paths": { "@/*": ["./src/*"], "@shared/*": ["../shared/*"] }
  },
  /* ../shared too: the SSE contract lives outside src and is imported through
     the "@shared" alias, so tsc has to see it or every import is an error the
     bundler happily resolves anyway. */
  "include": ["src", "../shared"]
}
